# __USER__ при установке заменяется на вашего пользователя Linux: см. deploy/README.md, шаг «Службы».
# Живой поток Finam: свечи, пересчёт спредов, ставки и фандинг раз в сутки.
[Unit]
Description=spread_terminal: run_live (Finam)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=/opt/spread_terminal
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/spread_terminal/venv/bin/python manage.py run_live
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
